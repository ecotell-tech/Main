# ── Production environment ──────────────────────────────────────────────
# Copy to .env.production on the VPS and fill in real values.
# NEVER commit .env.production — .gitignore already excludes .env.*
#
# This single file serves two purposes:
#  1. Docker Compose variable substitution (${VAR} in docker-compose.prod.yml)
#     — loaded via: docker compose -f docker-compose.prod.yml --env-file .env.production up -d
#  2. Vite build-time config — `vite build` auto-loads .env.production, and only
#     VITE_-prefixed keys below are bundled into the browser. Non-VITE_ keys
#     (MYSQL_*, DOMAIN, ACME_EMAIL) are used by Compose only and never reach the client.
# ──────────────────────────────────────────────────────────────────────────

# ── Domain / TLS (used by Caddy for automatic HTTPS) ─────────────────────
DOMAIN=example.com
ACME_EMAIL=you@example.com

# ── MySQL (used by Compose to configure the db container) ────────────────
MYSQL_DATABASE=profit_portal
MYSQL_USER=pscms
MYSQL_PASSWORD=change-me-to-a-strong-random-password
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-random-password

# ── Frontend build-time config (bundled into the browser, not secret) ────
# Caddy proxies /api/* to the backend, stripping the /api prefix.
VITE_API_BASE_URL=/api
VITE_AUTH_LOGIN_ENDPOINT=/auth/login
VITE_AUTH_OTP_ENDPOINT=/auth/verify-otp
VITE_AUTH_LOGOUT_ENDPOINT=/auth/logout
VITE_SESSION_KEY=pscms_session
VITE_APP_ENV=production

# Demo credentials — leave BLANK in production so the mock-login fallback
# has no valid credentials to demo/mock-auth with.
VITE_DEMO_AGRONOMIST_MOBILE=
VITE_DEMO_AGRONOMIST_PASSWORD=
VITE_DEMO_SUPERVISOR_MOBILE=
VITE_DEMO_SUPERVISOR_PASSWORD=
VITE_DEMO_ADMIN_MOBILE=
VITE_DEMO_ADMIN_PASSWORD=
VITE_DEMO_DEO_MOBILE=
VITE_DEMO_DEO_PASSWORD=
VITE_DEMO_MANAGER_MOBILE=
VITE_DEMO_MANAGER_PASSWORD=
