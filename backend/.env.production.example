# ── Backend production environment ──────────────────────────────────────
# Copy to backend/.env.production on the VPS and fill in real values.
# NEVER commit backend/.env.production — .gitignore already excludes .env.*
# Injected into the backend container at runtime only (never baked into the image).
# Keep MYSQL_USER / MYSQL_PASSWORD in sync with the root .env.production file.
# ──────────────────────────────────────────────────────────────────────────

# Database — 'db' is the service name on the compose network
DATABASE_URL=mysql+aiomysql://pscms:change-me-to-a-strong-random-password@db:3306/profit_portal

# Redis — 'redis' is the service name on the compose network
REDIS_URL=redis://redis:6379

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-secret-key

# PII encryption (Aadhaar, bank account) — generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes existing encrypted Aadhaar/bank data unrecoverable — back it up securely.
PII_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# CORS — since Caddy serves the frontend and proxies /api same-origin, this is
# mainly a safety net. Set to your real domain.
CORS_ORIGINS=["https://example.com"]
