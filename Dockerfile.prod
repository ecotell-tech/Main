# ── Stage 1: Build static assets ────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci && chmod +x node_modules/.bin/*
COPY . .
# Vite automatically loads .env.production for this build (mode=production)
RUN npm run build

# ── Stage 2: Serve via Caddy — static files + /api reverse proxy + auto HTTPS ─
FROM caddy:2-alpine
COPY --from=builder /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
